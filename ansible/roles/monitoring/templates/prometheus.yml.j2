global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: 15s

scrape_configs:
  - job_name: "node-exporter"
    static_configs:
      - targets: ["node-exporter:{{ node_exporter_port }}"]

  - job_name: "cortexops-backend"
    static_configs:
      - targets: ["host.docker.internal:{{ backend_port }}"]
